PORT=3000
ADMIN_KEY=change-this-admin-key
# Optional SMTP configuration. Without these, email notifications are logged to the server console.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
EMAIL_FROM="ShopEase <no-reply@example.com>"
# Payment provider integration is intentionally left in demo mode until you configure a real provider.
PAYMENT_MODE=demo
PAYMENT_PROVIDER=
PAYMENT_SECRET_KEY=
